; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Project NullSpace"
run/main_scene="uid://bkdc5mcuu4yl5"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/stretch/mode="disabled"

[autoload]

Signalbus="*res://scripts/autoload/signalbus.gd"
Modecontrol="*res://scripts/autoload/modecontrol.gd"
Wavecontrol="*res://scripts/autoload/wavecontrol.gd"
Shopcontrol="*res://scripts/autoload/shopcontrol.gd"

[display]

window/size/viewport_width=1700
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/terminal/plugin.cfg")

